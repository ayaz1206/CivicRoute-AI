# Backend environment configuration (M0)
# Copy to .env and adjust as needed. Do NOT commit .env.

APP_ENV=development

# Gate for unauthenticated staff/admin endpoints. When unset, these are enabled
# only in development (APP_ENV=development) and disabled everywhere else until
# authentication is implemented. Setting this to true enables them outside
# production only — in production, unauthenticated admin access is ALWAYS
# disabled regardless of this value.
# ALLOW_UNAUTHENTICATED_ADMIN=

# Async SQLAlchemy connection string (matches infra/docker-compose.yml defaults).
# The Docker DB is published on host port 5433 by default to avoid colliding
# with other local Postgres instances.
DATABASE_URL=postgresql+asyncpg://civicroute:civicroute@localhost:5433/civicroute

# API route prefix for versioned endpoints (health checks live outside this prefix)
API_PREFIX=/api

# Comma-separated list of allowed CORS origins (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000

# --- Boston 311 ingestion (M2) ---
# Resource id for the CKAN datastore (default: 311 Service Requests - 2025).
# BOSTON_311_RESOURCE_ID=9d7c2214-4709-478a-a2e8-fb2020a5bb94
# BOSTON_311_MAX_RECORDS=5000
# BOSTON_311_PAGE_SIZE=1000
